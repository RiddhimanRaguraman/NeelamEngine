<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- TOKENS ONLY. No styles/templates here — those live in         -->
    <!-- DarkTheme.xaml (visual styles) and ControlTemplates.xaml      -->
    <!-- (styles needing code-behind). This file must be merged FIRST  -->
    <!-- in App.xaml so the others can resolve these keys.             -->
    <!--                                                                -->
    <!-- Every color is declared as a raw <Color> and then wrapped in  -->
    <!-- a <SolidColorBrush>. The raw Color is needed wherever a brush  -->
    <!-- won't do: gradient stops (gradient Button), animated gradient  -->
    <!-- fills (project-browser glow), opacity variants.               -->
    <!-- ============================================================ -->

    <!-- ── Grey ramp ──────────────────────────────────────────────── -->
    <!-- Dark, low-contrast. 1 = darkest (window base) → 6 = lightest  -->
    <!-- (hover / raised border). Steps are deliberately gentle (~7-14 -->
    <!-- per channel) so panels read as one surface, not stripes.      -->
    <!-- Neutral grey (no hue) — accent is the only color in the app.  -->
    <Color x:Key="GrayColor1">#FF1A1A1A</Color>
    <Color x:Key="GrayColor2">#FF212121</Color>
    <Color x:Key="GrayColor3">#FF292929</Color>
    <Color x:Key="GrayColor4">#FF323232</Color>
    <Color x:Key="GrayColor5">#FF3C3C3C</Color>
    <Color x:Key="GrayColor6">#FF4A4A4A</Color>

    <SolidColorBrush x:Key="GrayBrush1" Color="{StaticResource GrayColor1}"/>
    <SolidColorBrush x:Key="GrayBrush2" Color="{StaticResource GrayColor2}"/>
    <SolidColorBrush x:Key="GrayBrush3" Color="{StaticResource GrayColor3}"/>
    <SolidColorBrush x:Key="GrayBrush4" Color="{StaticResource GrayColor4}"/>
    <SolidColorBrush x:Key="GrayBrush5" Color="{StaticResource GrayColor5}"/>
    <SolidColorBrush x:Key="GrayBrush6" Color="{StaticResource GrayColor6}"/>

    <!-- ── Semantic surface aliases ───────────────────────────────── -->
    <!-- The role names the app already uses, now mapped onto the ramp. -->
    <!-- Prefer these in styles; reach for GrayBrushN only when a step  -->
    <!-- is needed with no role (e.g. gradient stops).                  -->
    <SolidColorBrush x:Key="BaseBrush"    Color="{StaticResource GrayColor1}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource GrayColor2}"/>
    <SolidColorBrush x:Key="RaisedBrush"  Color="{StaticResource GrayColor3}"/>
    <SolidColorBrush x:Key="InputBrush"   Color="{StaticResource GrayColor4}"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource GrayColor5}"/>

    <!-- Splitter/divider bars. A soft mid-grey — visible against the dark panels
         but not the stark near-white of WPF's default GridSplitter. -->
    <Color x:Key="DividerColor">#4D4D4D</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <!-- ── Accent (the one hue) ───────────────────────────────────── -->
    <Color x:Key="AccentColor">#0048FF</Color>
    <Color x:Key="AccentHoverColor">#3D71F5</Color>
    <Color x:Key="AccentBtnColor">#1E5BF7</Color>
    <Color x:Key="SelectedColor">#094771</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>

    <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentBtnBrush"   Color="{StaticResource AccentBtnColor}"/>
    <SolidColorBrush x:Key="SelectedBrush"    Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>

    <!-- ── Text ───────────────────────────────────────────────────── -->
    <Color x:Key="TextColor">#CCCCCC</Color>
    <Color x:Key="TextBrightColor">#DDDDDD</Color>
    <Color x:Key="TextMutedColor">#9D9D9D</Color>

    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource TextBrightColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>

    <!-- ── Per-axis colors (X/Y/Z/W) ──────────────────────────────── -->
    <!-- For the inspector VectorBox/ScalarBox (a later phase). Kept    -->
    <!-- as tokens now so those controls have their palette ready.      -->
    <Color x:Key="AxisXColor">#FF5A6A</Color>
    <Color x:Key="AxisYColor">#90EE90</Color>
    <Color x:Key="AxisZColor">#80DEFF</Color>
    <Color x:Key="AxisWColor">#FFD067</Color>

    <SolidColorBrush x:Key="AxisXBrush" Color="{StaticResource AxisXColor}"/>
    <SolidColorBrush x:Key="AxisYBrush" Color="{StaticResource AxisYColor}"/>
    <SolidColorBrush x:Key="AxisZBrush" Color="{StaticResource AxisZColor}"/>
    <SolidColorBrush x:Key="AxisWBrush" Color="{StaticResource AxisWColor}"/>

    <!-- ── Typography ─────────────────────────────────────────────── -->
    <!-- Display face for large headings (project-browser tabs, etc.).  -->
    <!-- Bahnschrift ships with Windows 10+. Condensed is a stretch of  -->
    <!-- the same family; if unavailable WPF falls back gracefully.     -->
    <FontFamily x:Key="DisplayFontFamily">Bahnschrift</FontFamily>
    <FontFamily x:Key="DisplayFontFamilyCondensed">Bahnschrift Condensed</FontFamily>

</ResourceDictionary>
