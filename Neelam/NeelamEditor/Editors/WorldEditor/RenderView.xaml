<UserControl x:Class="NeelamEditor.Editors.RenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:NeelamEditor.Editors"
             mc:Ignorable="d"
             Background="{StaticResource BaseBrush}"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- The Vulkan surface is a native child HWND, so it is added from the
         code-behind (HwndHost cannot be declared usefully in XAML here it
         needs the engine brought up inside BuildWindowCore). -->
    <Grid x:Name="_surfaceHost"/>
</UserControl>
