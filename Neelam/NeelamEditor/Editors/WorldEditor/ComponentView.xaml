<UserControl x:Class="NeelamEditor.Editors.ComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NeelamEditor.Editors"
             mc:Ignorable="d" x:Name="componentView" MinWidth="280" Margin="0,0,0,1"
             d:DesignHeight="200" d:DesignWidth="300">
    <!-- Reusable framed section for one component. Header + expander; the actual
         fields are injected as ComponentContent (the ContentProperty), so each
         component view (TransformView, future MeshView…) just supplies a body. -->
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource InputBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Expander IsExpanded="True" Background="Transparent"
              Foreground="{StaticResource TextBrush}">
        <Expander.Header>
            <TextBlock Text="{Binding Header, ElementName=componentView}" FontWeight="Bold"/>
        </Expander.Header>
        <ContentPresenter Content="{Binding ComponentContent, ElementName=componentView}" Margin="5"/>
    </Expander>
</UserControl>
